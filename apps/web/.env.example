# Copy to .env.local for local development. Never commit real values.

# Derives the daily challenges and signs attempt tokens (32+ random characters).
# Required in production; without it, development and previews use a test value.
CHALLENGE_SECRET=

# Supabase Postgres through the transaction pooler, as the app_server role:
# postgres://app_server.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Without it the API stays stateless ("one attempt" is only checked in the browser).
DATABASE_URL=
